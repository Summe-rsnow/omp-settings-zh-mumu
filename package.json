{
  "name": "omp-settings-zh-mumu",
  "version": "0.3.0",
  "description": "Simplified Chinese settings localization for official Oh My Pi — no fork, no binary patch.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Summe-rsnow/omp-settings-zh-mumu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Summe-rsnow/omp-settings-zh-mumu.git"
  },
  "bugs": {
    "url": "https://github.com/Summe-rsnow/omp-settings-zh-mumu/issues"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "i18n",
    "localization",
    "chinese",
    "typescript",
    "developer-tools"
  ],
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "coverage:check": "bun run scripts/check-coverage.ts",
    "drift:check": "bun run scripts/diff-upstream.ts",
    "smoke": "bun run scripts/smoke-extension.ts",
    "check": "bun run typecheck && bun test && bun run coverage:check && bun run drift:check && bun run smoke"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ],
    "displayMetadata": "./src/desktop-display.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.0.4 <19"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.16.0",
    "@types/bun": "latest",
    "typescript": "5.9.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
